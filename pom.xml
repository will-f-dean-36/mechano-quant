<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.scijava</groupId>
		<artifactId>pom-scijava</artifactId>
		<version>43.0.0</version>
		<relativePath/>
	</parent>

	<groupId>com.will.mechanoquant</groupId>
	<artifactId>mechano-quant</artifactId>
	<version>0.7.0-SNAPSHOT</version>

	<name>MechanoQuant</name>
	<description>MechanoQuant is a Fiji/ImageJ plugin for segmenting cells in RICM images and measuring the resulting regions in source or paired images. It supports individual images, stacks, and batch workflows, with optional interactive threshold and ROI review.</description>
	<url>https://github.com/will-f-dean-36/mechano-quant</url>
	<inceptionYear>2026</inceptionYear>

	<organization>
		<name>CPMM</name>
	</organization>

	<licenses>
		<license>
			<name>BSD 2-Clause License</name>
			<url>https://github.com/will-f-dean-36/mechano-quant/blob/HEAD/LICENSE</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>will</id>
			<name>William F Dean</name>
			<url>https://github.com/will-f-dean-36</url>
			<roles>
				<role>founder</role>
				<role>lead</role>
				<role>developer</role>
				<role>debugger</role>
				<role>reviewer</role>
				<role>support</role>
				<role>maintainer</role>
			</roles>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:https://github.com/will-f-dean-36/mechano-quant</connection>
		<developerConnection>scm:git:https://github.com/will-f-dean-36/mechano-quant</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/will-f-dean-36/mechano-quant</url>
	</scm>

	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/will-f-dean-36/mechano-quant/issues</url>
	</issueManagement>

	<properties>
		<package-name>com.will.mechanoquant</package-name>

		<!-- Fiji compatibility -->
		<maven.compiler.release>8</maven.compiler.release>

		<!-- Required by pom-scijava enforcer -->
		<license.licenseName>bsd_2</license.licenseName>
		<license.copyrightOwners>William F Dean</license.copyrightOwners>

	</properties>

	<build>
		<finalName>Mechano_Quant-${project.version}</finalName>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<resource>
				<directory>${project.basedir}</directory>
				<targetPath>META-INF</targetPath>
				<includes>
					<include>LICENSE</include>
				</includes>
			</resource>
		</resources>

		<plugins>
			<!-- Keep metadata validation without requiring unused contributor, forum, or CI declarations. -->
			<plugin>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce-rules</id>
						<configuration>
							<rules>
								<requireElements implementation="org.scijava.maven.plugin.enforcer.RequireElements">
									<elements combine.self="override">
										<element>name</element>
										<element>description</element>
										<element>url</element>
										<element>inceptionYear</element>
										<element>organization</element>
										<element>licenses</element>
										<element>developers</element>
										<element>scm</element>
										<element>issueManagement</element>
										<element>properties//license.licenseName</element>
										<element>properties//license.copyrightOwners</element>
									</elements>
								</requireElements>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<!-- Usually not needed: pom-scijava + Central covers most things.
         If you do need SciJava public, this is the canonical URL. -->
	<repositories>
		<repository>
			<id>scijava.public</id>
			<url>https://maven.scijava.org/content/groups/public</url>
		</repository>
	</repositories>

	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>imagej</artifactId>
		</dependency>

		<!-- Needed for IJ1Helper in the classic menu wrapper -->
		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>imagej-legacy</artifactId>
		</dependency>

		<dependency>
			<groupId>ome</groupId>
			<artifactId>bio-formats_plugins</artifactId>
		</dependency>
	</dependencies>

</project>
